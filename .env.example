# ==============================================================================
# ZooID (MABIS) Çevresel Konfigürasyon Şablonu (.env)
# ==============================================================================
# Supabase Bulut Veritabanı ve Depolama Entegrasyonu
# Not: Bu değerler girilmediğinde sistem otomatik olarak yerel SQLite veritabanını kullanır.
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Tercih edilen depolama arka ucu: 'sqlite' | 'supabase'
STORAGE_BACKEND=sqlite

# Web Sunucusu
PORT=5000
HOST=0.0.0.0
DEBUG=False
